@model OntarioGo.Entity.UserEntity


@{
    Layout = null;
    string messageError = (string)TempData["messageError"];
    string message = (string)TempData["message"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OntarioGo - Sign In</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css"
          integrity="sha384-mzrmE5qonljUremFsqc01SB46JvROS7bZs3IO2EmfFsd15uHvIt+Y8vEf7N7fWAU"
          crossorigin="anonymous">
</head>
<body>
    @if (!string.IsNullOrEmpty(messageError))
    {
        <div class="error-banner">
            @messageError
        </div>

    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="success-banner">@message</div>
    }

    <main class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <h1><i class="fas fa-store"></i> OntarioGo</h1>
                <p>Welcome back to OntarioGo. Sign in to shop!</p>
            </div>

            <form asp-action="Login" class="login-form">
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-options">
                    <label><input type="checkbox" /> Remember Me</label>
                    <a href="/user/ForgotPassword">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-primary"><i class="fas fa-sign-in-alt"></i> Sign In</button>

                <div class="signup-link">
                    New here? <a href="/Auth/Register"><i class="fas fa-user-plus"></i> Create an account</a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>




