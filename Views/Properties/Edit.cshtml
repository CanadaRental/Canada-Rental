@model OntarioGo.Entity.PropertyEntity

@{
    ViewData["Title"] = "Edit Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/edit.css" />

<div class="edit-container">

    <div class="edit-card">

        <h2>✏️ Edit Property</h2>

        <form asp-action="Edit" method="post">

            <input asp-for="PropertyId" hidden />
            <input asp-for="OwnerId" hidden />

            <div asp-validation-summary="ModelOnly" class="error"></div>

            <div class="form-group">
                <label>Title</label>
                <input asp-for="Title" />
                <span asp-validation-for="Title" class="error"></span>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Description"></textarea>
                <span asp-validation-for="Description" class="error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Price</label>
                    <input asp-for="Price" type="number" step="0.01" />
                </div>

                <div class="form-group">
                    <label>Property Type</label>
                    <input asp-for="PropertyType" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>City</label>
                    <input asp-for="City" />
                </div>

                <div class="form-group">
                    <label>Province</label>
                    <input asp-for="Province" />
                </div>
            </div>

            <div class="form-group">
                <label>Address</label>
                <input asp-for="Address" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Bedrooms</label>
                    <input asp-for="Bedrooms" type="number" />
                </div>

                <div class="form-group">
                    <label>Bathrooms</label>
                    <input asp-for="Bathrooms" type="number" />
                </div>
            </div>

            <div class="checkbox-group">
                <input asp-for="IsAvailable" />
                <label>Available</label>
            </div>

            <div class="actions">
                <button type="submit" class="btn save">💾 Save</button>

                <a asp-action="Index" class="btn cancel">Cancel</a>

                <button type="button" class="btn delete" onclick="confirmDelete(@Model.PropertyId)">
                    🗑 Delete
                </button>
            </div>

        </form>

      
        <form id="deleteForm" method="post" asp-action="Delete">
            <input type="hidden" name="id" id="deleteId" />
        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this property?")) {
                document.getElementById("deleteId").value = id;
                document.getElementById("deleteForm").submit();
            }
        }
    </script>
}