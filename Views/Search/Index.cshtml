@model List<OntarioGo.Entity.PropertyEntity>

@{
    ViewData["Title"] = "Search Properties";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/search.css" />

<h2>Search Properties</h2>

<form asp-action="Search" method="post" class="search-form">
    <div>
        <label>City</label>
        <input type="text" name="city" placeholder="e.g. Toronto" />
    </div>

    <div>
        <label>Minimum Price</label>
        <input type="number" step="0.01" name="minPrice" />
    </div>

    <div>
        <label>Maximum Price</label>
        <input type="number" step="0.01" name="maxPrice" />
    </div>

    <div>
        <label>Property Type</label>
        <select name="propertyType">
            <option value="">All</option>
            <option value="House">House</option>
            <option value="Apartment">Apartment</option>
            <option value="Condo">Condo</option>
            <option value="Townhouse">Townhouse</option>
        </select>
    </div>

    <button type="submit">Search</button>
</form>

<hr />

<h3>Results</h3>

@if (Model != null && Model.Any())
{
    <div class="results">
        @foreach (var item in Model)
        {
            <div class="card">
                <h4>@item.Title</h4>

                <p><strong>City:</strong> @item.City</p>
                <p><strong>Address:</strong> @item.Address</p>
                <p><strong>Price:</strong> $@item.Price</p>
                <p><strong>Type:</strong> @item.PropertyType</p>

                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyId">
                    View Details
                </a>
            </div>
        }
    </div>
}
else
{
    <p>No results found.</p>
}