@model IEnumerable<OntarioGo.Entity.PropertyEntity>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-container">

    <div class="dashboard-header">
        <h2>Admin Dashboard</h2>
    </div>

    <div class="property-grid">
        @foreach (var item in Model)
        {
            <div class="property-card">

                <div class="property-info">
                    <h3>@item.Title</h3>
                    <p class="location">@item.City, @item.Province</p>
                    <p class="price">$@item.Price</p>

                    <span class="status @(item.IsAvailable ? "available" : "not-available")">
                        @(item.IsAvailable ? "Available" : "Not Available")
                    </span>
                </div>

                <div class="property-actions">
                    <a asp-action="ToggleAvailability" asp-route-id="@item.PropertyId" class="btn-toggle">
                        Toggle
                    </a>

                    <a asp-action="DeleteProperty" asp-route-id="@item.PropertyId" class="btn-delete">
                        Delete
                    </a>
                </div>

            </div>
        }
    </div>

</div>