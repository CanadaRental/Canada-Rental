@model IEnumerable<OntarioGo.Entity.UserEntity>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/users.css" />

<div class="users-container">

    <div class="users-header">
        <h2>Users Management</h2>
    </div>

    <div class="users-grid">
        @foreach (var item in Model)
        {
            <div class="user-card">

                <div class="user-info">
                    <h3>@item.FullName</h3>
                    <p class="email">@item.Email</p>

                    <span class="role @item.Role.ToLower()">
                        @item.Role
                    </span>

                    <span class="status @(item.IsActive ? "active" : "inactive")">
                        @(item.IsActive ? "Active" : "Blocked")
                    </span>
                </div>

                <div class="user-actions">
                    <a asp-action="ToggleUser" asp-route-id="@item.UserId" class="btn-toggle">
                        @(item.IsActive ? "Block" : "Activate")
                    </a>
                </div>

            </div>
        }
    </div>

</div>