
@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" href="~/css/change-password.css" />

<div class="password-container">

    <div class="password-card">

        <h2>🔒 Change Password</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert error">@ViewBag.Error</div>
        }

        <form asp-action="ChangePassword" method="post">

            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="oldPassword" required />
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" id="newPassword" required />
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" id="confirmPassword" required />
                <span id="matchError" class="error-text"></span>
            </div>

            <div class="actions">
                <button type="submit" class="btn save">Update Password</button>
                <a asp-action="Profile" class="btn cancel">Cancel</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        const newPass = document.getElementById("newPassword");
        const confirmPass = document.getElementById("confirmPassword");
        const errorText = document.getElementById("matchError");

        confirmPass.addEventListener("keyup", function () {
            if (newPass.value !== confirmPass.value) {
                errorText.innerText = "Passwords do not match";
            } else {
                errorText.innerText = "";
            }
        });
    </script>
}