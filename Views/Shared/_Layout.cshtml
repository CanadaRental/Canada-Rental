@using Microsoft.Data.SqlClient

@{
    int notificationCount = 0;

    if (User.Identity.IsAuthenticated)
    {
        var userIdClaim = User.FindFirst("UserId")?.Value;

        if (userIdClaim != null)
        {
            int userId = int.Parse(userIdClaim);

            string connectionString = "Server=ontariodb.mssql.somee.com;Database=ontariodb;User Id=ontariogo_SQLLogin_1;Password=rmf7zitki5;TrustServerCertificate=True;";

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                string query = "SELECT COUNT(*) FROM Notifications WHERE UserId = @UserId AND IsRead = 0";

                SqlCommand cmd = new SqlCommand(query, conn);
                cmd.Parameters.AddWithValue("@UserId", userId);

                conn.Open();
                notificationCount = (int)cmd.ExecuteScalar();
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OntarioGo</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Estilos -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OntarioGo.styles.css" asp-append-version="true" />

    @RenderSection("styles", required: false)
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    OntarioGo
                </a>

                <!-- Botón móvil -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar -->
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-center">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Properties" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Properties" asp-action="Create">
                                <i class="fas fa-plus-circle me-1"></i> Post
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Search" asp-action="Index">
                                <i class="fas fa-search me-1"></i> Search
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- 🔔 Notificaciones -->
                            <li class="nav-item position-relative me-3">
                                <a class="nav-link notification-icon" asp-controller="Notifications" asp-action="Index">
                                    <i class="fas fa-bell"></i>

                                    @if (notificationCount > 0)
                                    {
                                        <span class="notification-badge">@notificationCount</span>
                                    }
                                     Notifications
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Profile">
                                    <i class="fas fa-user me-1"></i> Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="fas fa-sign-out-alt me-1"></i> Log Out
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-chart-line me-1"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                    <i class="fas fa-users me-1"></i> Users
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Favorites" asp-action="Index">
                                    <i class="fas fa-heart me-1"></i> Favorites
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Messages" asp-action="Inbox">
                                     📩 Inbox
                                </a>
                            </li>

                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i> Sign In
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>